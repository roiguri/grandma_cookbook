# Firebase client config (safe to expose — security enforced by Firebase Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API key — local dev only (direct client call, not used in production)
VITE_GEMINI_API_KEY=

# --- Netlify environment variables (set in Netlify dashboard, not here) ---
# Server-side Gemini key used by the analyze-recipe function
# GEMINI_API_KEY=

# Firebase Web API key (same value as VITE_FIREBASE_API_KEY, used server-side to verify ID tokens)
# FIREBASE_API_KEY=

# Comma-separated list of allowed user emails for the analyze-recipe function
# Must match the emails array in Firestore settings/allowedUsers
# ALLOWED_EMAILS=user1@example.com,user2@example.com
